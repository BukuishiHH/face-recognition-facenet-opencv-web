# =============================================================================
# 环境变量模板：复制为 .env.development 后按需修改
#   PowerShell: Copy-Item .env.example .env.development
# .env.development / .env.production 不入库（见 frontend/.gitignore）
# =============================================================================

# 后端 API 前缀（axios baseURL），末尾不要带斜杠
VITE_API_BASE_URL=http://127.0.0.1:8000/api

# 结果图静态资源 origin（/static 不在 /api 下，需单独拼接）
VITE_STATIC_ORIGIN=http://127.0.0.1:8000

# 实时识别截帧参数（阶段 4-4 使用）
VITE_FRAME_INTERVAL_MS=400
VITE_FRAME_MAX_WIDTH=640
VITE_FRAME_QUALITY=0.8
